# Copy to .env and fill in. .env is gitignored and must stay that way.
#
# Seeds are runtime config, never constants in source. A league ID is the key to
# that league's full roster, transaction, and draft history with no auth
# required — treat it like a credential.

# Crawl seed. Set at least one. A league ID seeds from that league's members;
# a username is resolved to a user ID once and then discarded.
SLEEPER_SEED_LEAGUE_ID=
SLEEPER_SEED_USERNAME=

# Season to crawl and aggregate (Sleeper uses string years).
SLEEPER_SEASON=2025

# Salt for the SHA-256 hashing of user IDs. Any long random string. Keep it
# stable or crawl dedupe resets; keep it secret or the hashes are reversible by
# anyone who can enumerate user IDs.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SLEEPER_USER_ID_SALT=

# Requests per minute. Sleeper's stated ceiling is 1000 before an IP block.
# Do not raise this to make a crawl finish faster.
SLEEPER_RATE_LIMIT_PER_MIN=300

# Local SQLite database.
SLEEPER_DB_PATH=sleeper_aav.sqlite3

# Cached /players/nfl dump (~5MB, refetched at most once a day).
SLEEPER_PLAYER_CACHE=players_nfl.json

# Drafts with a keeper share above this are discarded whole. The 0.40 is a
# guess — move it once there is a real distribution to look at.
KEEPER_DRAFT_THRESHOLD=0.40

# Budget that normalized prices are rendered back to at display time.
REFERENCE_BUDGET=200
